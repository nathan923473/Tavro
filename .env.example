# Public site URL for share links in production (e.g. https://app.yourdomain.com)
NEXT_PUBLIC_APP_URL=

# Supabase — copy these names into .env.local (NEVER paste real keys in this file)
NEXT_PUBLIC_SUPABASE_URL=
# anon (legacy) or publishable key from Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (sign-up without email / rate limits). Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Official Instagram handle for creator DM verification (must be an account Tavro owns).
# Example: OFFICIAL_VERIFICATION_DM_TARGET=@yourhandle on Instagram
OFFICIAL_VERIFICATION_DM_TARGET=

# Web Push (optional, later)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
