# Public site URL for share links in production (e.g. https://app.yourdomain.com)
NEXT_PUBLIC_APP_URL=

# Supabase — copy these names into .env.local (NEVER paste real keys in this file)
NEXT_PUBLIC_SUPABASE_URL=
# anon (legacy) or publishable key from Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Records inbox ownership after a real confirmation link, rate limits,
# and admin tasks. Never use it to mark a normal sign-up as confirmed.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile. The site key is public. The secret stays on the server.
# Production sign-up fails closed until both are set. Also enable the same widget
# under Supabase → Authentication → Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shown on Become a creator DM verification step
OFFICIAL_VERIFICATION_DM_TARGET=@streaklyverify on Instagram

# Web Push (optional, later)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
